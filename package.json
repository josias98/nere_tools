{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "setup:ca": "powershell -ExecutionPolicy Bypass -File scripts/setup-ca-bundle.ps1",
        "setup:https": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-https.ps1",
        "serve:https": "concurrently -k -n laravel,https -c \"#fdba74,#93c5fd\" \"php artisan serve --host=127.0.0.1 --port=8000\" \"node scripts/https-proxy.mjs\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
