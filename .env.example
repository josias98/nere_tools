APP_NAME="Nere Tools"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost:8443

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_STORAGE_DRIVER=database
PULSE_INGEST_DRIVER=storage
PULSE_STORAGE_KEEP="7 days"

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://localhost:8443/auth/microsoft/callback
MICROSOFT_SCOPES="openid profile email User.Read"
MICROSOFT_CA_BUNDLE=storage/app/certs/cacert.pem

GRAPH_MAIL_ENABLED=true
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
GRAPH_MAIL_FROM_ADDRESS=tools@nerecapital.com
GRAPH_MAIL_FROM_NAME="Nere Tools"
GRAPH_MAIL_SAVE_TO_SENT_ITEMS=true
GRAPH_MAIL_TIMEOUT=15
GRAPH_MAIL_CONNECT_TIMEOUT=10
GRAPH_MAIL_TOKEN_CACHE_KEY=nere_tools_graph_mail_token
GRAPH_MAIL_TEST_RECIPIENT=

LEAVE_CERTIFICATE_SIGNATORY_NAME="Monsieur ZONGO P. Job"
LEAVE_CERTIFICATE_SIGNATORY_TITLE="Directeur Général"

LOCAL_HTTPS_PORT=8443
LOCAL_LARAVEL_HTTP_PORT=8000
LOCAL_HTTPS_PFX_PATH=storage/local-certs/localhost.pfx
LOCAL_HTTPS_PFX_PASSPHRASE=nere-tools-local-dev

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME="Administrateur Nere Tools"
